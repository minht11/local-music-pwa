{
	"name": "local-music-pwa",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#lib/*": "./src/lib/*",
		"#i18n/runtime": "./.generated/i18n/runtime.ts"
	},
	"scripts": {
		"prepare": "svelte-kit sync",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"type-check": "svelte-kit sync && svelte-check",
		"i18n-check": "node scripts/check-translations.ts",
		"biome-check": "biome check .",
		"biome-fix": "biome check . --write",
		"test": "vitest run",
		"gen-color-theme": "node scripts/gen-color-theme.ts",
		"knip": "knip"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@resvg/resvg-js": "^2.6.2",
		"@rolldown/pluginutils": "^1.0.1",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.0.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "^26.6.4",
		"@types/wicg-file-system-access": "^2023.10.7",
		"fake-indexeddb": "^6.2.5",
		"fast-check": "^4.10.2",
		"happy-dom": "^20.14.5",
		"image-size": "^2.0.4",
		"knip": "^6.40.0",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"unplugin-auto-import": "^21.1.0",
		"vite": "8.3.3",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@tanstack/virtual-core": "^3.17.11",
		"color-space": "^3.1.0",
		"idb": "^8.0.4",
		"mediabunny": "1.61.3",
		"music-metadata": "^12.0.0",
		"tiny-invariant": "^1.3.3",
		"weak-lru-cache": "^1.2.2"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.11.0"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "12.12.1"
		}
	}
}
