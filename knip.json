{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"tags": ["-lintignore"],
	"entry": [
		"src/env.ts",
		"src/params.ts",
		"src/routes/**/*",
		"src/lib/stores/**/*",
		".generated/types/auto-imports.d.ts"
	],
	"project": ["**/*", "!static/supported-browser-check.js"],
	"ignoreExportsUsedInFile": {
		"interface": true,
		"type": true
	},
	"ignoreUnresolved": ["^\\./\\$types\\.ts$"],
	"ignoreDependencies": ["i18n"]
}
